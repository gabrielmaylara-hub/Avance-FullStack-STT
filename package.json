{
  "name": "stt-avance-fullstack",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=22.13.0" },
  "scripts": {
    "preparar": "node scripts/preparar-demo.mjs",
    "build": "vite build",
    "check": "tsc --noEmit",
    "db:local": "wrangler d1 migrations apply DB --local --persist-to .wrangler/state",
    "start": "wrangler dev --local --persist-to .wrangler/state --ip 127.0.0.1 --port 8787 --inspector-port 0",
    "dev": "npm run build && npm start",
    "test": "node --test tests/api.test.mjs",
    "datos:demo": "node scripts/datos-demo.mjs",
    "cloudflare:login": "wrangler login",
    "db:remote": "wrangler d1 migrations apply DB --remote",
    "deploy": "npm run check && npm run build && wrangler deploy"
  },
  "dependencies": {
    "lucide-react": "1.31.0",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "4.20260515.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "typescript": "5.9.3",
    "vite": "8.0.13",
    "wrangler": "4.92.0"
  }
}
