{
  "name": "stt-solicitudes-de-soporte",
  "version": "3.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "check": "tsc --noEmit",
    "build": "npm run check && vite build",
    "start": "node --env-file-if-exists=.env backend/server.js",
    "debug": "node --env-file-if-exists=.env --inspect=127.0.0.1:9229 backend/server.js",
    "test": "node --test tests/*.test.js",
    "preparar": "node scripts/preparar-local.js"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.3.15",
    "express": "^5.1.0",
    "jsonwebtoken": "^9.0.2",
    "lucide-react": "1.31.0",
    "pg": "^8.16.3",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router-dom": "^7.9.5"
  },
  "devDependencies": {
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "typescript": "~5.9.3",
    "vite": "^7.2.2",
    "@vitejs/plugin-react": "^5.1.0"
  }
}
