# npm run preparar crea .env con valores aleatorios para una instalación local.
# Con PostgreSQL de servidor, define también DATABASE_URL.
PORT=3000
PGLITE_DIR=./data/stt
# DATABASE_URL=postgresql://usuario:clave@servidor:5432/stt
# PUBLIC_ORIGIN=https://tu-dominio
# JWT_SECRET, ADMIN_PASSWORD y TECH_PASSWORD deben configurarse en privado.
