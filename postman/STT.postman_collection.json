            ]
          }
        }
      ]
    },
    {
      "name": "10 · Comprobar restricción de eliminación",
      "request": {
        "method": "DELETE",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/solicitudes/{{idCaso}}",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"version\": {{version}}\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
