{
  "info": {
    "name": "STT · Solicitudes de soporte",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Ejecuta las peticiones en orden desde Collection Runner, con el entorno STT seleccionado. Agrega las dos contraseñas de Acceso.txt a tus valores locales del entorno. Postman conserva la cookie automáticamente. La colección crea y elimina un caso ficticio propio."
  },
  "item": [
    {
      "name": "01 · Salud del servidor y la base",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/salud"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200', () => pm.response.to.have.status(200));"
            ]
          }
        }
      ]
    },
    {
      "name": "02 · Ingresar como técnico",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/auth/login",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"usuario\": \"tecnico@stt.test\",\n  \"password\": \"{{techPassword}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
              "pm.test('Cuenta de técnico', () => pm.expect(pm.response.json().usuario.rol).to.eql('tecnico'));"
            ]
          }
        }
      ]
    },
    {
      "name": "03 · Verificar sesión",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/auth/me"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200', () => pm.response.to.have.status(200));"
            ]
          }
        }
      ]
    },
    {
      "name": "04 · Crear un caso ficticio",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/solicitudes",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"cliente\": \"CLI-815\",\n  \"titulo\": \"Revisión de impresora de recepción\",\n  \"descripcion\": \"La impresora de recepción pierde la conexión de red durante la jornada.\",\n  \"categoria\": \"Redes\",\n  \"prioridad\": \"Media\",\n  \"estado\": \"Pendiente\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 201', () => pm.response.to.have.status(201));",
              "pm.test('Guarda el folio y la versión del caso creado', () => {",
              "  const s = pm.response.json().solicitud;",
              "  pm.expect(s.id).to.be.above(0);",
              "  pm.collectionVariables.set('idCaso', String(s.id));",
              "  pm.collectionVariables.set('version', String(s.version));",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "05 · Abrir detalle por ID",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/solicitudes/{{idCaso}}"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200', () => pm.response.to.have.status(200));"
            ]
          }
        }
      ]
    },
    {
      "name": "06 · Actualizar el estado",
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/solicitudes/{{idCaso}}",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"cliente\": \"CLI-815\",\n  \"titulo\": \"Revisión de impresora de recepción\",\n  \"descripcion\": \"La impresora de recepción pierde la conexión de red durante la jornada.\",\n  \"categoria\": \"Redes\",\n  \"prioridad\": \"Media\",\n  \"estado\": \"En proceso\",\n  \"version\": {{version}}\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
              "pm.test('El cambio incrementó la versión', () => {",
              "  const s = pm.response.json().solicitud;",
              "  pm.expect(s.version).to.eql(Number(pm.collectionVariables.get('version')) + 1);",
              "  pm.expect(s.estado).to.eql('En proceso');",
              "  pm.collectionVariables.set('version', String(s.version));",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "07 · Filtrar y paginar solicitudes",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/solicitudes?categoria=Redes&pagina=1&limite=2"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
              "pm.test('Página limitada y con filtros', () => {",
              "  const b = pm.response.json();",
              "  pm.expect(b.solicitudes.length).to.be.at.most(2);",
              "  pm.expect(b.paginacion.pagina).to.eql(1);",
              "  b.solicitudes.forEach(s => pm.expect(s.categoria).to.eql('Redes'));",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "08 · Consultar clima para visitas",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/clima"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
              "pm.test('Lectura del proveedor', () => pm.expect(pm.response.json().data.fuente).to.eql('Open-Meteo'));"
            ]
          }
        }
      ]
    },
    {
      "name": "09 · Comprobar restricción de bitácora",
      "request": {
        "method": "GET",
